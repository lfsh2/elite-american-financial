# Required
DATABASE_URL=postgresql://user:password@localhost:5432/textflow

# Development mode (enables simulation fallbacks)
NODE_ENV=development

# Optional - Twilio (leave empty for simulation mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBERS=+15551234567

# Optional - SendGrid (leave empty for simulation mode)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@textflow.ai
